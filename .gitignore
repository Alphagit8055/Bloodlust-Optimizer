target/
Cargo.lock
!src-tauri/Cargo.lock

# --- Tauri ---
src-tauri/gen/
src-tauri/WixTools/

# --- Node (only used for the signer) ---
node_modules/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

