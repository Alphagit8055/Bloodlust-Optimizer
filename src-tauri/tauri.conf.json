{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloodlust Optimizer",
  "version": "0.1.0",
  "identifier": "io.github.alphagit8055.bloodlust",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bloodlust Optimizer",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Emulator and Windows performance tuning",
    "longDescription": "Bloodlust Optimizer applies reversible Windows, GPU, network and GameLoop tweaks, with a one-click undo for every change.",
    "publisher": "Telegram: @Alpha0NemesiSS",
    "homepage": "https://github.com/Alphagit8055/Bloodlust-Optimizer",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "sidecar/bloodlust-sidecar.exe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "minimumWebview2Version": "1.0.0"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Alphagit8055/Bloodlust-Optimizer/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_OUTPUT_OF_tauri_signer_generate",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
