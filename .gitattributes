# Line endings.
#
# Without this file, every Windows checkout prints a warning per file and can
# produce spurious whole-file diffs when an editor re-saves with CRLF. Setting
# `text=auto` makes git normalise to LF in the repository while letting your
# working copy stay native, which removes the warnings and the churn.

* text=auto eol=lf

# Windows scripts must keep CRLF or cmd.exe mis-parses them.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never touch binaries. Autodetection is usually right, but being explicit
# avoids a corrupted .ico or .exe if one is ever added.
*.png  binary
*.ico  binary
*.icns binary
*.exe  binary
*.dll  binary
*.pyd  binary

# Diffs: these are generated and huge, so collapsing them keeps `git diff`
# readable if one ever does get committed.
*.lock linguist-generated=true
Cargo.lock linguist-generated=true -diff
